# Base class
class Superhero:
    def __init__(self, name, power, strength):
        self.name = name
        self.power = power
        self.__strength = strength  # Encapsulated (private)

    def display_power(self):
        print(f"{self.name} uses {self.power}!")

    def get_strength(self):  # Getter for encapsulated attribute
        return self.__strength

    def set_strength(self, new_strength):  # Setter with logic
        if new_strength > 0:
            self.__strength = new_strength
        else:
            print("Strength must be positive!")

# Subclass with polymorphism
class FlyingHero(Superhero):
    def display_power(self):
        print(f"{self.name} soars through the skies using {self.power}! ✈️")

# Subclass with different behavior
class SpeedHero(Superhero):
    def display_power(self):
        print(f"{self.name} speeds through enemies with {self.power}! ⚡")

# Creating objects
hero1 = FlyingHero("SkyMan", "Flight", 90)
hero2 = SpeedHero("Dash", "Super Speed", 80)

# Using methods
hero1.display_power()
print("Strength:", hero1.get_strength())

hero2.display_power()
hero2.set_strength(100)
print("New Strength:", hero2.get_strength())
